# Cloudflare Pages headers. Vite copies everything in public/ to the build
# output root, so this ends up as build/_headers.
#
# Pages applies EVERY matching rule and joins duplicate header names with a
# comma. Cache-Control therefore appears on /assets/* only — repeating it under
# /* would produce "public, max-age=0, must-revalidate, public, max-age=..."
# instead of overriding it.
#
# HTML needs no explicit rule: Pages already serves it as
# "Cache-Control: public, max-age=0, must-revalidate", so a new deploy is picked
# up on the next request.
#
# HSTS is deliberately absent — enable it once per zone under
# SSL/TLS > Edge Certificates > HSTS, otherwise Cloudflare's own header and this
# one get joined into an invalid value.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin

# Vite emits content-hashed filenames here, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
