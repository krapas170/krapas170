# Dependencies
node_modules/

# Build output
build/
dist/

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Cloudflare Wrangler local state.
# Targeted patterns on purpose: a blanket "*.json" would also swallow
# package.json, wrangler.jsonc and src/utils/*.json on the next `git add`.
.wrangler/
.dev.vars
.dev.vars.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
