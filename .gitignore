# Dependencies
node_modules/

# Build output
build/
dist/

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Firebase service account keys and local state.
# Targeted patterns on purpose: a blanket "*.json" would also swallow
# package.json, firebase.json and src/utils/*.json on the next `git add`.
*-firebase-adminsdk-*.json
serviceAccountKey.json
service-account*.json
.runtimeconfig.json
.firebase/
firebase-debug.log*
firebaseConfig.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
